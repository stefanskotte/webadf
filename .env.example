# The https address you open webadf at (an IP or a LAN name). Caddy makes a certificate for it.
WEBADF_URL=https://192.168.1.10
# OR, for a public DNS name pointing at this host (Let's Encrypt, port 443): leave WEBADF_URL empty and set
# WEBADF_DOMAIN=amiga.example.org
# The first admin. Sign up with this address using the link the app prints: docker compose logs app
WEBADF_ADMIN_EMAIL=you@example.org
# Optional
# WEBADF_DATA_DIR=./data
# WEBADF_HTTPS_PORT=443
# WEBADF_IMAGE_TAG=latest
