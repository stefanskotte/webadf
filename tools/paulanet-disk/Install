; Install -- puts PaulaNET.device (webadf's LZ4 build of Rob Smith's
; driver) in place for a TCP/IP stack, and webadf's Transfer in SYS:Tools
; (with its icon) and C:. An older Receive (Transfer's former name) is
; removed from SYS:Tools and C:.
; From webadf (https://github.com/stefanskotte/webadf). Safe to run more
; than once: the driver and Transfer are copied again, and an existing eth0
; is never changed.
FailAt 21
If NOT EXISTS DEVS:Networks
  MakeDir DEVS:Networks
EndIf
Copy PaulaNET:PaulaNET.device DEVS:Networks/ CLONE QUIET
If WARN
  Echo "Could not copy PaulaNET.device to DEVS:Networks."
  Echo "The driver was not copied; eth0 was not touched."
  Skip DONE
EndIf
Echo "Copied PaulaNET.device to DEVS:Networks."
If NOT EXISTS SYS:Tools
  MakeDir SYS:Tools
EndIf
Copy PaulaNET:Transfer SYS:Tools/ CLONE QUIET
If WARN
  Skip NOTRANSFER
EndIf
Copy PaulaNET:Transfer.info SYS:Tools/ CLONE QUIET
If WARN
  Skip NOTRANSFER
EndIf
Copy PaulaNET:Transfer C: CLONE QUIET
If WARN
  Skip NOTRANSFER
EndIf
Echo "Copied Transfer to SYS:Tools and C:."
If EXISTS SYS:Tools/Receive
  Delete SYS:Tools/Receive QUIET
EndIf
If EXISTS SYS:Tools/Receive.info
  Delete SYS:Tools/Receive.info QUIET
EndIf
If EXISTS C:Receive
  Delete C:Receive QUIET
EndIf
Skip ETH
Lab NOTRANSFER
Echo "Could not copy Transfer to SYS:Tools and C:."
Echo "The driver is in place; Transfer also runs from this disk."
Lab ETH
If EXISTS DEVS:NetInterfaces/eth0
  Echo "DEVS:NetInterfaces/eth0 already exists: left as it is."
  Echo "For PaulaNET it needs these three lines:"
  Echo "  device=PaulaNET.device"
  Echo "  unit=0"
  Echo "  configure=dhcp"
Else
  If NOT EXISTS DEVS:NetInterfaces
    MakeDir DEVS:NetInterfaces
  EndIf
  Echo >DEVS:NetInterfaces/eth0 "device=PaulaNET.device"
  Echo >>DEVS:NetInterfaces/eth0 "unit=0"
  Echo >>DEVS:NetInterfaces/eth0 "configure=dhcp"
  If WARN
    Delete DEVS:NetInterfaces/eth0 QUIET
    Echo "Could not write DEVS:NetInterfaces/eth0; it was removed."
    Skip DONE
  EndIf
  Echo "Wrote DEVS:NetInterfaces/eth0."
EndIf
Echo ""
Echo "Next, in a Shell:  AddNetInterface eth0"
Echo "To go online at every start, add that line to S:User-Startup."
Lab DONE
Echo ""
Ask "Press Return to close this window."
