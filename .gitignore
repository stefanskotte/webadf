# Disk images — never commit. Copyrighted content and 55+ MB of binaries.
adf-archive/
*.adf
*.ADF
*.dsk
*.DSK
*.adz
*.dms

node_modules/
.next/
.env
.env.local
.env*
.vercel
dist/
build/
.DS_Store

# next.js scaffold defaults
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/coverage
/out
*.pem
# ...except the firmware signing PUBLIC keys, which exist to be distributed:
# increment 2 compiles one into the image and verifies downloaded firmware
# against it. The private half lives at ~/.webadf/firmware-signing-key and is
# never in this tree at all, so the blanket rule above protects nothing here.
!wifi-floppy/firmware/keys/*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# Design canvas build output (re-seeded from the .dc.html working files)
design/webadf-interface.html

# SDD scratch — ledger, briefs, review packages
.superpowers/
test-results/
playwright-report/

# Bulk TOSEC downloads: ~1 GB of disk images and DAT packs. Reference data the
# operator fetches by hand, never part of the repo. Anchored to the repo root
# (leading /) so this doesn't also match src/app/api/admin/tosec/.
/tosec-archive/
/tosec/

# OpenRetro's synced game database, dropped in by the operator. Reference data
# obtained through FS-UAE Launcher, never part of the repo.
/Amiga.sqlite
*.sqlite

# Playwright MCP browser session artifacts (snapshots, console logs).
.playwright-mcp/

# Editor/tool backups (generate_pcb.py.bak and friends).
*.bak

# Harness-managed git worktrees (Claude Code). Never commit them.
.claude/worktrees/

# Local editor config. Machine-specific (it hardcodes an absolute path to the
# firmware source dir), and an untracked file here marks the git tree dirty --
# which the firmware version generator reports as +g<hash>-dirty and the
# release script refuses to publish.
.vscode/

# The firmware CI clones the pico-sdk into the workspace, which is the git
# work tree. Untracked, it would make every CI build report itself -dirty via
# cmake/gen_version_header.cmake and therefore be unpublishable.
/pico-sdk/
